<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Lodestone</ApplicationTitle>
    <ApplicationId>com.denkinop.lodestone</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationManifest>Platforms/Windows/app.manifest</ApplicationManifest>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <FrontendDirectory>$(MSBuildThisFileDirectory)../../frontend/dist</FrontendDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <ProjectReference Include="../Lodestone.Core/Lodestone.Core.csproj" />
    <MauiAsset Include="$(FrontendDirectory)/**/*" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../data/preview/scene.json" LogicalName="Lodestone.Preview.Scene" />
    <EmbeddedResource Include="../../data/preview/coat.png" LogicalName="Lodestone.Preview.Coat" />
  </ItemGroup>
  <Target Name="RequireFrontend" BeforeTargets="PrepareForBuild" Condition="!Exists('$(FrontendDirectory)/index.html')">
    <Error Text="Build the frontend first with scripts/build-windows.ps1." />
  </Target>
</Project>
